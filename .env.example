# Rosie Atelier — environment variables (copy to .env.local for development or production)

# ── Admin panel (REQUIRED in production) ────────────────────────────────
# Without these two, /api/auth/login returns 401 "admin_not_configured" in production.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ── Owner account (راضیه خیری‌پور) ──────────────────────────────────────
# The email of the site owner. A logged-in user whose email matches this value
# gains owner-level access to /[locale]/owner/* management pages
# (portfolio & academy content management).
OWNER_EMAIL=

# HMAC key for the session cookie. Any long random string, e.g. `openssl rand -hex 32`.
# If unset, ADMIN_PASSWORD is used as the signing key — set a dedicated one.
AUTH_SECRET=

# ── Content persistence ────────────────────────────────────────────────
# Option 1: Upstash Redis for shared or persistent deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# With neither, content falls back to ./data/content.json.

# ── Image upload storage ────────────────────────────────────────────────
# Option 1: Cloudinary (recommended for production CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option 2: Vercel Blob (if deploying on Vercel)
BLOB_READ_WRITE_TOKEN=

# Without either, uploads are saved to public/images/uploads/ (dev only).

# ── Master-file storage (digital downloads — Phase 1) ───────────────────
# Private binaries buyers download after purchase (TIFF/PSD/AI/EPS/PDF/ZIP…).
# Any S3-compatible object storage works; Cloudflare R2 recommended (no egress fees).
# Example (R2):   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Example (B2):   S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Without S3_* the master files are stored privately in data/private/ and
# streamed through the authenticated /api/download route (fine for dev/VPS).

# ── Payment gateway (digital sales — ZarinPal) ──────────────────────────
# Merchant id from panel.zarinpal.com. Prices are stored in Toman and sent
# to the gateway ×10 as Rial.
ZARINPAL_MERCHANT_ID=
# Use the ZarinPal sandbox instead of production (1 = sandbox).
ZARINPAL_SANDBOX=
# Without a merchant id the gateway runs in MOCK mode: the checkout →
# entitlement → download cycle works locally without any external account.

# ── Artist royalties (Phase 3) ───────────────────────────────────────────
# Artist share of every verified digital sale, in percent (0–90, default 70).
# Admin settles balances in the admin panel → «درآمد و تسویه» (Payouts).
ARTIST_ROYALTY_PERCENT=

# ── Stripe (Phase 4 — USD buyers) ────────────────────────────────────────
# Secret key from dashboard.stripe.com → offered automatically to visitors in
# the English locale when a pattern has a USD price. Without it the USD flow
# runs in MOCK mode locally (entitlement still gets minted; nothing is charged).
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/digital/stripe-webhook
# (Dashboard → Webhooks → checkout.session.completed → same URL).
STRIPE_WEBHOOK_SECRET=

# ── Email via Resend (Phase 4) ───────────────────────────────────────────
# Purchase confirmations to buyers + payout notifications to artists.
# EMAIL_FROM example: Rosie Atelier <orders@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# ── ClamAV virus scanning for master-file uploads (Phase 4) ──────────────
# Set CLAMAV_ENABLED=1 to enforce scanning. Two transports:
#   CLAMAV_URL   → HTTP proxy with POST /scan (body=bytes, reply "OK"|"FOUND <sig>")
#   CLAMAV_HOST/CLAMAV_PORT → raw clamd INSTREAM over TCP (default 127.0.0.1:3310)
# When enabled and the scanner is unreachable, uploads are BLOCKED (503).
CLAMAV_ENABLED=
CLAMAV_URL=
CLAMAV_HOST=
CLAMAV_PORT=

# ── Canonical site URL (used by sitemap.xml, robots.txt and OG metadata) ─
# Set this to your public URL WITHOUT a trailing slash.
NEXT_PUBLIC_SITE_URL=
